{
  "name": "dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Configurable terminal dashboard with liturgical, developer, and system widgets",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "tsx watch src/app.tsx",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "lint": "eslint src/**/*.ts src/**/*.tsx test/**/*.ts test/**/*.tsx",
    "lint:fix": "eslint src/**/*.ts src/**/*.tsx test/**/*.ts test/**/*.tsx --fix"
  },
  "dependencies": {
    "@mishieck/ink-titled-box": "^0.4.2",
    "ink": "^8.0.0",
    "ink-big-text": "^2.0.0",
    "js-yaml": "^5.5.0",
    "react": "^19.3.1",
    "romcal": "^1.3.0",
    "systeminformation": "^5.33.19"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
